{
  "name": "contextcue",
  "version": "0.1.2",
  "private": true,
  "description": "A local-first desktop reply assistant for WeChat, Slack, Lark, and any visible conversation.",
  "author": "zilong",
  "license": "UNLICENSED",
  "keywords": [
    "desktop",
    "reply-assistant",
    "electron",
    "local-first"
  ],
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "@fontsource-variable/inter": "^5.2.6",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "ai.contextcue.desktop",
    "productName": "ContextCue",
    "copyright": "Copyright © 2026 zilong",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "ContextCue uses screenshots you select to understand the visible conversation and draft replies.",
        "NSAppleEventsUsageDescription": "ContextCue uses system automation only when you choose to insert a reply into another application."
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icons",
      "target": [
        "AppImage"
      ]
    }
  }
}
