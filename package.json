{
  "name": "hiply",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop reply assistant for WeChat, Slack, Lark, and any visible conversation.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "@fontsource-variable/inter": "^5.2.6",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "ai.hiply.desktop",
    "productName": "Hiply",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Hiply uses screenshots you select to understand the visible conversation and draft replies.",
        "NSMicrophoneUsageDescription": "Hiply uses the microphone only when you choose voice input."
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
